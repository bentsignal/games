{
  "name": "games",
  "version": "1.0.0",
  "description": "Games for friends",
  "scripts": {
    "test": "vitest run && node --test scripts/setup.test.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build:web",
    "preview": "vite preview",
    "backend": "node scripts/backend-dev.mjs",
    "test:e2e": "playwright test",
    "test:map": "tsx scripts/map-proof.tsx && tsx scripts/check-map.ts",
    "test:feedback": "tsx scripts/check-feedback.ts",
    "test:live": "tsx scripts/live-smoke.ts",
    "format": "prettier --write src services shared tests scripts/*.{ts,mjs} *.ts *.json *.md docs",
    "dev:direct": "vite",
    "grams:dev": "pnpm --filter @games/grams dev",
    "grams:deploy": "wrangler deploy --config services/grams/wrangler.jsonc --env \"\"",
    "grams:check": "pnpm --filter @games/grams typecheck",
    "grams:test": "tsx scripts/grams-worker-test.ts",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev:web": "node scripts/web-dev.mjs",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "turbo run typecheck typecheck:web",
    "typecheck:web": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@convex-dev/auth": "2.0.0-alpha.1",
    "@fontsource/bree-serif": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "canvas-confetti": "^1.9.4",
    "convex": "^1.45.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "convex-test": "^0.0.56",
    "miniflare": "^5.20260908.0-alpha",
    "portless": "^0.13.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0",
    "turbo": "2.10.12",
    "workerd": "1.20260908.1"
  },
  "private": true,
  "engines": {
    "node": ">=24",
    "pnpm": ">=10 <11"
  },
  "portless": {
    "name": "games.bentsignal",
    "script": "dev:direct"
  },
  "packageManager": "pnpm@10.34.5"
}
