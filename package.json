{
  "name": "railbound-1910",
  "version": "1.0.0",
  "description": "A classic illustrated multiplayer railway game for the USA and USA 1910 ticket collection",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "backend": "convex dev",
    "test:e2e": "playwright test",
    "test:map": "tsx scripts/map-proof.tsx && tsx scripts/check-map.ts",
    "test:feedback": "tsx scripts/check-feedback.ts",
    "test:live": "tsx scripts/live-smoke.ts",
    "format": "prettier --write src convex tests scripts/*.ts *.ts *.json *.md docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@convex-dev/auth": "2.0.0-alpha.1",
    "@fontsource/bree-serif": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "convex": "^1.45.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "convex-test": "^0.0.56",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
